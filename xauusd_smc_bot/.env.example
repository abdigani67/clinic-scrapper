# ---------------------------------------------------------------------------
# XAUUSD SMC Bot — environment template
# Copy this file to `.env` and fill in your real IC Markets MT5 details.
# NEVER commit your real .env file.
# ---------------------------------------------------------------------------

# Your IC Markets MT5 account number (integer).
MT5_LOGIN=12345678

# Your MT5 account password.
MT5_PASSWORD=your-password-here

# Broker server name.
#   Demo: ICMarketsSC-Demo
#   Live: ICMarketsSC-Live
# Leave blank to auto-select based on DEMO_MODE in config.py.
MT5_SERVER=ICMarketsSC-Demo

# Optional: full path to terminal64.exe if MT5 cannot auto-detect it.
# Example: C:\Program Files\MetaTrader 5 IC Markets\terminal64.exe
MT5_TERMINAL_PATH=
